{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@rue-js",
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "."
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "app/**/*.d.ts"]
}
